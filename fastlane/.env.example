# Copy to fastlane/.env for local release builds, then fill in the values.
# That file is gitignored - this one is committed, so it must stay empty.
#
# ORG_GRADLE_PROJECT_<name> is Gradle's own convention for supplying a project
# property through the environment, so these reach signingConfigs.release in
# android/app/build.gradle with nothing wiring them up in between. CI sets the
# exact same variable names from repository secrets, so local and CI releases
# are signed through one mechanism rather than two.
#
# Passing them this way rather than with -P also keeps the passwords out of the
# process list.

ORG_GRADLE_PROJECT_TALLY_STORE_FILE=
ORG_GRADLE_PROJECT_TALLY_STORE_PASSWORD=
ORG_GRADLE_PROJECT_TALLY_KEY_PASSWORD=

# Only the `github` lane needs this - a personal access token with `repo` scope.
# In CI the workflow supplies it from ${{ github.token }} instead.
GH_TOKEN=
