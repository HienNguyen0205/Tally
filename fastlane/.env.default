# Non-secret defaults, loaded by fastlane for every lane, locally and in CI.
# Keep secrets out of this file - it is committed. See .env.example.
#
# The key alias is an identifier, not a credential: `keytool -list` prints it
# from any keystore. Living here means it is one fewer GitHub secret to manage.
ORG_GRADLE_PROJECT_TALLY_KEY_ALIAS=tally
